# Copy to .env.production (never commit). All values marked required must be set.
# Generate secrets with: openssl rand -hex 64

RAILS_ENV=production

# Required: Rails session / cookie signing
SECRET_KEY_BASE=

# Required: public site URL used in mailers / Telegram links (include scheme)
APP_HOST=https://example.com

# Optional comma-separated extra Host headers (in addition to getcourt.co defaults)
# RAILS_ALLOWED_HOSTS=example.com,www.example.com

# Required: PostgreSQL (Compose service name is "db"; do not publish 5432 to the internet)
DATABASE_USERNAME=getcourt
DATABASE_PASSWORD=
DATABASE_NAME=getcourt_production
DATABASE_CACHE_NAME=getcourt_production_cache
DATABASE_QUEUE_NAME=getcourt_production_queue
DATABASE_CABLE_NAME=getcourt_production_cable

# Published only to the reverse-proxy host / private network
WEB_PORT=3000

# Mail (Resend)
RESEND_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional integrations
MCP_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_WEATHER_API_KEY=
GOOGLE_TIMEZONE_API_KEY=
APP_TIME_ZONE=Asia/Yekaterinburg
RAILS_LOG_LEVEL=info

# Must stay empty/false when the dedicated worker service is running
SOLID_QUEUE_IN_PUMA=
