<% content_for :meta_robots, "noindex, follow" %>

<div class="mx-auto max-w-3xl space-y-6 px-4 py-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-slate-100"><%= @community.name %></h1>
      <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">
        <%= @community.city_name.presence || "—" %>
        · <%= t("communities.visibility.#{@community.visibility}") %>
        · <%= t("communities.membership_policy.#{@community.membership_policy}") %>
        · <%= t("communities.index.members", count: @community.member_count) %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @community.can_edit_settings?(current_user) %>
        <%= link_to t("communities.show.edit"), edit_community_path(@community), class: "rounded-md border px-3 py-1.5 text-sm dark:border-white/15" %>
      <% end %>
      <% if @membership&.active? %>
        <%= button_to t("communities.actions.leave"), community_membership_path(@community, @membership), method: :delete, class: "rounded-md border border-red-300 px-3 py-1.5 text-sm text-red-700" %>
      <% elsif @membership&.pending? %>
        <span class="text-sm text-amber-700 dark:text-amber-300"><%= t("match_results.status.pending") %></span>
      <% elsif @my_invitation&.pending? %>
        <div class="flex flex-wrap gap-2">
          <%= button_to t("communities.actions.accept_invite"), accept_community_invitation_path(@my_invitation), method: :post, class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm text-white" %>
          <%= button_to t("communities.actions.decline_invite"), decline_community_invitation_path(@my_invitation), method: :post, class: "rounded-md border px-3 py-1.5 text-sm" %>
        </div>
      <% elsif @community.public? %>
        <%= button_to (@community.open_join? ? t("communities.actions.join") : t("communities.actions.request")),
              community_memberships_path(@community), method: :post,
              class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm text-white hover:bg-indigo-700" %>
      <% else %>
        <span class="text-sm text-gray-500 dark:text-slate-400"><%= t("communities.show.invite_only_hint") %></span>
      <% end %>
    </div>
  </div>

  <% if @full_access && @community.description.present? %>
    <div class="rounded-lg border bg-white p-4 text-sm text-gray-700 dark:border-white/10 dark:bg-slate-800/80 dark:text-slate-200">
      <%= simple_format(h(@community.description)) %>
    </div>
  <% end %>

  <% if @pending.any? %>
    <section class="space-y-2">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100"><%= t("communities.show.pending") %></h2>
      <ul class="space-y-2">
        <% @pending.each do |membership| %>
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border bg-white p-3 dark:border-white/10 dark:bg-slate-800/80">
            <span class="text-sm"><%= membership.user.name.presence || t("users.show.anonymous_name") %></span>
            <div class="flex gap-2">
              <%= button_to t("communities.actions.approve"), approve_community_membership_path(@community, membership), method: :post, class: "rounded-md bg-indigo-600 px-2 py-1 text-xs text-white" %>
              <%= button_to t("communities.actions.decline"), decline_community_membership_path(@community, membership), method: :post, class: "rounded-md border px-2 py-1 text-xs" %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @community.can_manage?(current_user) %>
    <section class="space-y-3">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100"><%= t("communities.show.invitations") %></h2>
      <% if @pending_invitations.any? %>
        <ul class="space-y-2">
          <% @pending_invitations.each do |invitation| %>
            <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border bg-white p-3 dark:border-white/10 dark:bg-slate-800/80">
              <span class="text-sm">
                <%= invitation.invitee.name.presence || t("users.show.anonymous_name") %>
                <span class="text-xs text-gray-500"> · <%= l(invitation.expires_at.to_date, format: :short) %></span>
              </span>
              <%= button_to t("communities.actions.revoke_invite"), revoke_community_invitation_path(invitation), method: :post, class: "rounded border border-red-300 px-2 py-0.5 text-xs text-red-700" %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <%= form_with url: invite_community_path(@community), method: :post, local: true, class: "space-y-2" do %>
        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300"><%= t("communities.show.invite_player") %></label>
        <div class="min-w-0 w-full max-w-md">
          <%= render "shared/user_picker", field_name: "user_id",
                placeholder: t("communities.show.invite_placeholder"),
                aria_label: t("communities.show.invite_player"),
                class: "w-full" %>
        </div>
        <%= submit_tag t("communities.actions.invite"), class: "min-h-10 rounded-md bg-indigo-600 px-3 py-2 text-sm text-white cursor-pointer" %>
      <% end %>
    </section>
  <% end %>

  <section class="space-y-2">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100"><%= t("communities.show.members") %></h2>
    <ul class="space-y-2">
      <% @members.each do |membership| %>
        <% user = membership.user %>
        <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border bg-white p-3 dark:border-white/10 dark:bg-slate-800/80">
          <div class="text-sm">
            <% if user.profile_visible_to?(current_user) %>
              <%= link_to (user.name.presence || t("users.show.anonymous_name")), user_path(user), class: "font-medium text-indigo-700 hover:underline dark:text-indigo-300" %>
            <% else %>
              <span class="font-medium"><%= t("users.show.anonymous_name") %></span>
            <% end %>
            <span class="text-gray-500 dark:text-slate-400"> · <%= t("communities.roles.#{membership.role}") %></span>
          </div>
          <% if @community.can_manage?(current_user) && membership.user_id != current_user.id %>
            <div class="flex flex-wrap gap-1">
              <% if @community.owner?(current_user) && membership.active? && membership.role == "member" %>
                <%= button_to t("communities.actions.promote"), promote_community_membership_path(@community, membership), method: :post, class: "rounded border px-2 py-0.5 text-xs" %>
              <% end %>
              <% if @community.owner?(current_user) && membership.moderator_role? %>
                <%= button_to t("communities.actions.demote"), demote_community_membership_path(@community, membership), method: :post, class: "rounded border px-2 py-0.5 text-xs" %>
                <%= button_to t("communities.actions.transfer"), transfer_community_membership_path(@community, membership), method: :post, class: "rounded border px-2 py-0.5 text-xs" %>
              <% end %>
              <%= button_to t("communities.actions.remove"), remove_community_membership_path(@community, membership), method: :post, class: "rounded border border-red-300 px-2 py-0.5 text-xs text-red-700" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100"><%= t("communities.show.upcoming") %></h2>
      <% if @community.active_member?(current_user) %>
        <%= link_to t("communities.show.create_game"), new_community_game_path(@community), class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm text-white hover:bg-indigo-700" %>
      <% end %>
    </div>
    <% if @upcoming_games.any? %>
      <ul class="space-y-2">
        <% @upcoming_games.each do |game| %>
          <li class="rounded-lg border bg-white p-3 text-sm dark:border-white/10 dark:bg-slate-800/80">
            <%= link_to "#{l(game.date, format: :long)} · #{game.court_name}", game_path(game), class: "text-indigo-700 hover:underline dark:text-indigo-300" %>
            <% if @community.can_manage?(current_user) || game.user_id == current_user.id %>
              <%= button_to t("communities.show.unlink"), community_game_path(@community, game), method: :delete, class: "mt-1 text-xs text-red-600" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("communities.show.no_games") %></p>
    <% end %>

    <% if @community.active_member?(current_user) %>
      <% linkable = current_user.games.not_canceled.where(invite_only: false, community_id: nil).order(date: :desc).limit(20) %>
      <% if linkable.any? %>
        <%= form_with url: community_games_path(@community), method: :post, local: true, class: "flex flex-wrap items-end gap-2" do %>
          <div>
            <%= label_tag :game_id, t("communities.show.link_game"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
            <%= select_tag :game_id, options_from_collection_for_select(linkable, :id, ->(g) { "#{g.date} · #{g.court_name}" }), class: "mt-1 rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700" %>
          </div>
          <%= submit_tag t("communities.show.link_game"), class: "rounded-md bg-indigo-600 px-3 py-2 text-sm text-white cursor-pointer" %>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-2">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100"><%= t("communities.show.recent") %></h2>
    <% if @recent_games.any? %>
      <ul class="space-y-2">
        <% @recent_games.each do |game| %>
          <li class="rounded-lg border bg-white p-3 text-sm dark:border-white/10 dark:bg-slate-800/80">
            <%= link_to "#{l(game.date, format: :long)} · #{game.court_name}", game_path(game), class: "text-indigo-700 hover:underline dark:text-indigo-300" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("communities.show.no_games") %></p>
    <% end %>
  </section>
</div>
