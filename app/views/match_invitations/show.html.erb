<% content_for :meta_robots, "noindex, follow" %>
<% other = @invitation.other_participant(current_user) %>

<div class="mx-auto max-w-xl space-y-4 px-4 py-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-slate-100"><%= t("match_invitations.show.title") %></h1>
    <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">
      <%= t("users.profile.play_format.#{@invitation.play_format}") %>
      · <%= other&.name.presence || t("users.show.anonymous_name") %>
    </p>
  </div>

  <div class="rounded-lg border bg-white p-4 space-y-3 dark:border-white/10 dark:bg-slate-800/80">
    <p class="text-sm text-gray-700 dark:text-slate-300">
      <span class="font-medium"><%= t("match_invitations.status.#{@invitation.status}") %></span>
      <% unless @invitation.scheduling_status == "none" %>
        · <%= t("match_invitations.scheduling.#{@invitation.scheduling_status}") %>
      <% end %>
    </p>

    <% if @invitation.proposed_at.present? %>
      <p class="text-sm text-gray-700 dark:text-slate-300">
        <%= t("match_invitations.form.proposed_at") %>:
        <%= l(@invitation.proposed_at, format: :short) %>
      </p>
    <% end %>
    <% if @invitation.court.present? %>
      <p class="text-sm text-gray-700 dark:text-slate-300">
        <%= t("match_invitations.form.court") %>: <%= @invitation.court.name %>
      </p>
    <% end %>
    <% if @invitation.message.present? %>
      <p class="text-sm text-gray-700 dark:text-slate-300"><%= @invitation.message %></p>
    <% end %>
    <% if @invitation.proposal_note.present? %>
      <p class="text-sm text-gray-700 dark:text-slate-300"><%= @invitation.proposal_note %></p>
    <% end %>

    <% if @invitation.scheduling_proposed? && @invitation.awaiting_confirmation_from == current_user %>
      <p class="text-sm text-amber-700 dark:text-amber-300"><%= t("match_invitations.card.your_turn") %></p>
      <%= button_to t("match_invitations.actions.confirm"), confirm_invitation_path(@invitation),
            method: :post,
            params: { proposal_updated_at: @invitation.proposal_updated_at&.iso8601(6) },
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-700" %>
    <% elsif @invitation.scheduling_proposed? && @invitation.proposed_by_id == current_user.id %>
      <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("match_invitations.card.waiting_for_other") %></p>
    <% end %>

    <% if @invitation.game.present? %>
      <%= link_to t("match_invitations.card.view_game"), game_path(@invitation.game), class: "inline-block text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
      <% if @invitation.open_doubles_slots.positive? %>
        <p class="text-sm text-gray-500 dark:text-slate-400"><%= t("match_invitations.card.doubles_slots", count: @invitation.open_doubles_slots) %></p>
      <% end %>
    <% end %>
  </div>

  <% if @invitation.accepted? && !@invitation.scheduled? %>
    <div class="rounded-lg border bg-white p-4 dark:border-white/10 dark:bg-slate-800/80">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-slate-100 mb-3">
        <%= @invitation.scheduling_proposed? ? t("match_invitations.form.change_proposal") : t("match_invitations.form.propose_title") %>
      </h2>
      <%= form_with url: propose_invitation_path(@invitation), method: :post, local: true, scope: :match_invitation, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :proposed_at, t("match_invitations.form.proposed_at"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= f.datetime_local_field :proposed_at,
                value: @invitation.proposed_at&.strftime("%Y-%m-%dT%H:%M"),
                required: true,
                class: "mt-1 block w-full rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
        <div>
          <%= f.label :court_id, t("match_invitations.form.court"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= f.collection_select :court_id, @courts, :id, :name,
                { include_blank: t("match_invitations.form.court_blank"), selected: @invitation.court_id },
                class: "mt-1 block w-full rounded border px-3 py-2 dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
        <div>
          <%= f.label :proposal_note, t("match_invitations.form.proposal_note"), class: "block text-sm font-medium text-gray-700 dark:text-slate-300" %>
          <%= f.text_area :proposal_note, rows: 2, maxlength: MatchInvitation::PROPOSAL_NOTE_MAX,
                value: @invitation.proposal_note,
                class: "mt-1 block w-full rounded border px-3 py-2 text-sm dark:border-white/15 dark:bg-slate-700 dark:text-slate-100" %>
        </div>
        <%= f.submit t("match_invitations.form.submit_proposal"), class: "rounded-md bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700 cursor-pointer" %>
      <% end %>
    </div>
  <% end %>

  <%= link_to t("match_invitations.show.back"), invitations_path, class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
</div>
