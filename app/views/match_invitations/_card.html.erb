<% other = invitation.other_participant(current_user) %>
<li class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-slate-800/80" data-testid="invitation-<%= invitation.id %>">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 space-y-1">
      <p class="font-semibold text-gray-900 dark:text-slate-100">
        <%= link_to (other&.name.presence || t("users.show.anonymous_name")), user_path(other), class: "hover:underline" if other %>
      </p>
      <p class="text-sm text-gray-600 dark:text-slate-400">
        <%= t("users.profile.play_format.#{invitation.play_format}") %>
        <% if invitation.proposed_at.present? %>
          · <%= l(invitation.proposed_at, format: :short) %>
        <% end %>
        <% if invitation.court.present? %>
          · <%= invitation.court.name %>
        <% end %>
      </p>
      <% if invitation.message.present? %>
        <p class="text-sm text-gray-700 dark:text-slate-300"><%= invitation.message %></p>
      <% end %>
      <% if invitation.proposal_note.present? %>
        <p class="text-sm text-gray-700 dark:text-slate-300"><%= invitation.proposal_note %></p>
      <% end %>
      <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-slate-400">
        <%= t("match_invitations.status.#{invitation.status}") %>
        <% unless invitation.scheduling_status == "none" %>
          · <%= t("match_invitations.scheduling.#{invitation.scheduling_status}") %>
        <% end %>
      </p>
      <% if invitation.scheduling_proposed? && invitation.awaiting_confirmation_from == current_user %>
        <p class="text-xs text-amber-700 dark:text-amber-300"><%= t("match_invitations.card.your_turn") %></p>
      <% elsif invitation.scheduling_proposed? && invitation.proposed_by_id == current_user.id %>
        <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("match_invitations.card.waiting_for_other") %></p>
      <% end %>
      <% if invitation.game.present? %>
        <%= link_to t("match_invitations.card.view_game"), game_path(invitation.game), class: "text-sm text-indigo-600 hover:underline dark:text-indigo-400" %>
        <% if invitation.open_doubles_slots.positive? %>
          <p class="text-xs text-gray-500 dark:text-slate-400"><%= t("match_invitations.card.doubles_slots", count: invitation.open_doubles_slots) %></p>
        <% end %>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if perspective == :received && invitation.pending? %>
        <%= button_to t("match_invitations.actions.accept"), accept_invitation_path(invitation), method: :post, class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm text-white hover:bg-indigo-700" %>
        <%= button_to t("match_invitations.actions.decline"), decline_invitation_path(invitation), method: :post, class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 dark:border-white/15 dark:text-slate-200" %>
      <% elsif perspective == :sent && invitation.pending? %>
        <%= button_to t("match_invitations.actions.cancel"), cancel_invitation_path(invitation), method: :post, class: "rounded-md border border-red-200 px-3 py-1.5 text-sm text-red-600 hover:bg-red-50 dark:border-red-400/30" %>
      <% elsif invitation.accepted? && %w[needed proposed].include?(invitation.scheduling_status) %>
        <%= link_to t("match_invitations.actions.coordinate"), invitation_path(invitation), class: "rounded-md bg-indigo-600 px-3 py-1.5 text-sm text-white hover:bg-indigo-700" %>
      <% end %>
    </div>
  </div>
</li>
